{
  "info": {
    "name": "FitnessTracker - User API",
    "_postman_id": "a1b2c3d4-e5f6-7890-1234-56789abcdef0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Get all users",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "url": {
          "raw": "http://localhost:8080/v1/users",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["v1", "users"]
        }
      }
    },
    {
      "name": "Get user by ID",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "url": {
          "raw": "http://localhost:8080/v1/users/1",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["v1", "users", "1"]
        }
      }
    },
    {
      "name": "Get user by email",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "url": {
          "raw": "http://localhost:8080/v1/users/email?email=test",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["v1", "users", "email"],
          "query": [
            { "key": "email", "value": "test" }
          ]
        }
      }
    },
    {
      "name": "Get users older than date",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "url": {
          "raw": "http://localhost:8080/v1/users/older/2000-01-01",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["v1", "users", "older", "2000-01-01"]
        }
      }
    },
    {
      "name": "Create user",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"birthdate\": \"1995-05-20\",\n  \"email\": \"john.doe@mail.com\"\n}"
        },
        "url": {
          "raw": "http://localhost:8080/v1/users",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["v1", "users"]
        }
      }
    },
    {
      "name": "Update user",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"Updated\",\n  \"lastName\": \"User\",\n  \"birthdate\": \"1990-01-01\",\n  \"email\": \"updated@mail.com\"\n}"
        },
        "url": {
          "raw": "http://localhost:8080/v1/users/1",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["v1", "users", "1"]
        }
      }
    },
    {
      "name": "Delete user",
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "url": {
          "raw": "http://localhost:8080/v1/users/1",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["v1", "users", "1"]
        }
      }
    }
  ]
